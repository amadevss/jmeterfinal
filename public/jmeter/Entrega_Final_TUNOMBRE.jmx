<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
<hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="ENTREGA FINAL · Clínica Digital API · ESCRIBE TU NOMBRE" enabled="true">
<stringProp name="TestPlan.comments">1) Cambia participante por tu nombre y servidor por la direccion de la API. 2) Agrega tus 5 peticiones. 3) Copia los codigos de mision al portal.</stringProp>
<boolProp name="TestPlan.functional_mode">false</boolProp>
<boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
<elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="protocolo" elementType="Argument"><stringProp name="Argument.name">protocolo</stringProp><stringProp name="Argument.value">https</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="servidor" elementType="Argument"><stringProp name="Argument.name">servidor</stringProp><stringProp name="Argument.value">TU-PROYECTO.vercel.app</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="puerto" elementType="Argument"><stringProp name="Argument.name">puerto</stringProp><stringProp name="Argument.value"></stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="participante" elementType="Argument"><stringProp name="Argument.name">participante</stringProp><stringProp name="Argument.value">ESCRIBE_TU_NOMBRE</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="curp" elementType="Argument"><stringProp name="Argument.name">curp</stringProp><stringProp name="Argument.value">RIGL620203MNLVMC08</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="token" elementType="Argument"><stringProp name="Argument.name">token</stringProp><stringProp name="Argument.value">clinica123</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="hora" elementType="Argument"><stringProp name="Argument.name">hora</stringProp><stringProp name="Argument.value">${__Random(10,17)}:${__Random(10,59)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp>
</TestPlan>
<hashTree>
<ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="Servidor Clínica Digital API" enabled="true">
<elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp>
<stringProp name="HTTPSampler.domain">${servidor}</stringProp><stringProp name="HTTPSampler.port">${puerto}</stringProp><stringProp name="HTTPSampler.protocol">${protocolo}</stringProp><stringProp name="HTTPSampler.path"></stringProp>
</ConfigTestElement>
<hashTree>
</hashTree>
<HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Quién soy (mi nombre)" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Participante</stringProp><stringProp name="Header.value">${participante}</stringProp></elementProp></collectionProp></HeaderManager>
<hashTree>
</hashTree>
<ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Mis 5 misiones (agrega aquí tus peticiones)" enabled="true">
<stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
<elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Bucle" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp>
<stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">1</stringProp>
<boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp>
<boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
</ThreadGroup>
